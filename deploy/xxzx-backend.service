[Unit]
Description=XX甄选 - FastAPI Backend
After=network.target mysql.service redis.service
Wants=mysql.service redis.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/xxzx/python-bff
Environment="PYTHONPATH=/opt/xxzx/python-bff"
ExecStart=/bin/bash /opt/xxzx/deploy/run_backend.sh
Restart=always
RestartSec=5
StandardOutput=append:/var/log/xxzx/backend.log
StandardError=append:/var/log/xxzx/backend.log

[Install]
WantedBy=multi-user.target
