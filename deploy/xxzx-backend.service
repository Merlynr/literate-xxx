[Unit]
Description=XX甄选 - FastAPI Backend
After=network.target mysql.service redis.service
Wants=mysql.service redis.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/xxzx/python-bff
Environment="PYTHONPATH=/opt/xxzx/python-bff"
ExecStart=/opt/xxzx/deploy/run_backend.sh
Restart=always
RestartSec=5
StandardOutput=append:/var/log/xxzx/backend.log
StandardError=append:/var/log/xxzx/backend.log

# 环境变量
EnvironmentFile=/opt/xxzx/python-bff/.env

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log/xxzx /var/run/xxzx /tmp

[Install]
WantedBy=multi-user.target
