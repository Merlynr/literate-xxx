[Unit]
Description=XX甄选 - Celery Worker
After=network.target redis.service xxzx-backend.service
Wants=redis.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/xxzx/python-bff
Environment="PYTHONPATH=/opt/xxzx/python-bff"
ExecStart=/opt/xxzx/deploy/run_celery.sh
Restart=always
RestartSec=5
StandardOutput=append:/var/log/xxzx/celery.log
StandardError=append:/var/log/xxzx/celery.log

[Install]
WantedBy=multi-user.target
